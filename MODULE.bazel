"""squzy monorepo - Bazel module (Bzlmod)."""

module(
    name = "squzy",
    version = "0",
)

# --- Core Go rules ---------------------------------------------------------
bazel_dep(name = "rules_go", version = "0.55.1", repo_name = "io_bazel_rules_go")
bazel_dep(name = "gazelle", version = "0.44.0", repo_name = "bazel_gazelle")

# --- Container images (replaces archived rules_docker) ---------------------
bazel_dep(name = "rules_oci", version = "2.2.6")
bazel_dep(name = "rules_pkg", version = "1.0.1")

# --- Go SDK ----------------------------------------------------------------
go_sdk = use_extension("@io_bazel_rules_go//go:extensions.bzl", "go_sdk")
go_sdk.download(version = "1.23.4")

# --- Go dependencies (replaces 306 WORKSPACE go_repository entries) ---------
# Read directly from go.mod / go.sum. `bazel mod tidy` populates use_repo below.
go_deps = use_extension("@bazel_gazelle//:extensions.bzl", "go_deps")
go_deps.from_file(go_mod = "//:go.mod")
use_repo(go_deps, "com_github_antonmedv_expr", "com_github_araddon_dateparse", "com_github_clickhouse_clickhouse_go", "com_github_data_dog_go_sqlmock", "com_github_gin_gonic_gin", "com_github_go_redis_redis_v8", "com_github_go_redis_redismock_v8", "com_github_gocql_gocql", "com_github_golang_protobuf", "com_github_google_uuid", "com_github_grpc_ecosystem_go_grpc_middleware", "com_github_jinzhu_gorm", "com_github_ory_dockertest_v3", "com_github_shirou_gopsutil_v3", "com_github_slack_go_slack", "com_github_squzy_mongo_helper", "com_github_squzy_squzy_generated", "com_github_stretchr_testify", "com_github_tidwall_gjson", "org_golang_google_grpc", "org_golang_google_protobuf", "org_golang_x_sync", "org_mongodb_go_mongo_driver", "org_uber_go_atomic", "org_uber_go_zap")

# --- Container base image --------------------------------------------------
oci = use_extension("@rules_oci//oci:extensions.bzl", "oci")
oci.pull(
    name = "distroless_static",
    # Distroless static base, matching rules_docker's go_image default.
    # Digest pinned for reproducibility (gcr.io/distroless/static:nonroot).
    image = "gcr.io/distroless/static",
    digest = "sha256:d29e660cc75a5b6b1334e03c5c81ccf9bc0884a002c6000dbf0fb96034814478",
    platforms = ["linux/amd64"],
)
use_repo(oci, "distroless_static", "distroless_static_linux_amd64")
